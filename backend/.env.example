# LearnMate Backend - Environment Configuration
# Copy this file to .env and fill in your IBM Cloud credentials.
# Without credentials the app runs in DEMO mode automatically.

# ── IBM watsonx.ai (required for LIVE AI responses) ───────────────────────────
# 1. Create a free IBM Cloud account: https://cloud.ibm.com
# 2. Provision watsonx.ai and create a project
# 3. Go to IAM > API keys and create an API key
# 4. Copy your Project ID from the project settings page
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://au-syd.ml.cloud.ibm.com
IBM_GRANITE_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Demo mode override ────────────────────────────────────────────────────────
# Set to true to force demo mode even when credentials are present
DEMO_MODE=
